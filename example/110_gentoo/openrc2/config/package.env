# Erzeugt von tools/apply-batch.sh, Stufe 1.
# NICHT von Hand editieren; Batches + hold.txt liegen in config/batches/.
# Toolchain/libc bleiben immer unsanitisiert (ASan braucht saubere libc).
sys-libs/glibc nosanitizer
sys-devel/gcc nosanitizer
sys-devel/binutils nosanitizer
# --- batch-01 ---
app-shells/bash sanitizers
sys-apps/coreutils sanitizers
sys-apps/util-linux sanitizers
sys-apps/grep sanitizers
sys-apps/sed sanitizers
